generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum BookingStatus {
  PENDING // waiting for email confirmation, holds the slot for a limited time
  CONFIRMED
  CANCELLED
  EXPIRED // pending that was never confirmed
}

model Booking {
  id           String        @id @default(cuid())
  startAt      DateTime      @db.Timestamptz(3)
  endAt        DateTime      @db.Timestamptz(3)
  name         String
  email        String
  phone        String
  note         String?
  locale       String        @default("ro")
  status       BookingStatus @default(PENDING)
  confirmToken String        @unique
  cancelToken  String        @unique
  ip           String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  confirmedAt  DateTime?     @db.Timestamptz(3)
  cancelledAt  DateTime?     @db.Timestamptz(3)

  @@index([startAt])
  @@index([email])
  @@index([phone])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  startAt   DateTime @db.Timestamptz(3)
  endAt     DateTime @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([startAt])
}

/// Single-row table (id = 1) with venue settings editable from admin.
model Settings {
  id                 Int  @id @default(1)
  /// { "0": { "open": "09:00", "close": "23:00" } | null, ... } — 0 = Sunday
  hours              Json
  pricePerHour       Int  @default(200)
  maxAdvanceDays     Int  @default(30)
  pendingHoldMinutes Int  @default(30)
  maxActivePerPerson Int  @default(2)
  maxDurationMinutes Int  @default(180)
}

/// Booking attempts, used for per-IP rate limiting.
model BookingAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([ip, createdAt])
}
